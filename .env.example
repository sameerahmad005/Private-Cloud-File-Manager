APP_ENV=production
APP_URL=http://localhost:5000
PORT=5000

AUTH_ENABLED=true
SESSION_SECRET=your_random_session_secret_32bytes_min

# Storage Provider (google_drive for production, virtual for mock dev/test)
STORAGE_PROVIDER=google_drive

# Google Drive OAuth Credentials (configured via /setup wizard or here)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Application Policy & Limits
MAX_UPLOAD_SIZE=52428800
SESSION_TIMEOUT=60
RATE_LIMIT=100
