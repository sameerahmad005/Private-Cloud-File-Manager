{
  "name": "private-cloud-file-manager",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "description": "Private Cloud File Manager backed by Google Drive API v3",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "postinstall": "npm --prefix server install --include=dev && npm --prefix client install --include=dev",
    "start": "node app.js",
    "test": "node server/dist/test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
